# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
MONGO_URI=
TELEGRAM_BOT_TOKEN=
# Dominio público del servicio, con https:// y sin barra final (p. ej. https://mi-bot.onrender.com)
WEBHOOK_DOMAIN=
# Secreto que Telegram envía en cada petición del webhook (1-256 caracteres: A-Z a-z 0-9 _ -).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
PORT=3000
# Solo para depurar: con true se registran datos de usuario. No lo actives en producción.
DEBUG=false
# Google Calendar (opcional): sin ninguna de las dos, /calendar no se ofrece y el bot funciona igual.
# Clave JSON de la cuenta de servicio. En producción, el JSON en base64 (variable secreta):
#   node -e "console.log(require('fs').readFileSync(process.argv[1]).toString('base64'))" clave.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# En local basta la ruta al archivo (guárdalo fuera del repositorio, nunca lo subas a git).
GOOGLE_SERVICE_ACCOUNT_FILE=
